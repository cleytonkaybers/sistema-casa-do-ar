{
  "name": "Servico",
  "type": "object",
  "properties": {
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do cliente (opcional)"
    },
    "telefone": {
      "type": "string",
      "description": "N\u00famero de telefone do cliente"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude da localiza\u00e7\u00e3o"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude da localiza\u00e7\u00e3o"
    },
    "tipo_servico": {
      "type": "string",
      "description": "Tipo de servi\u00e7o de ar condicionado. Texto livre: o app grava tipos compostos separados por ' + ' e metadados entre colchetes (ex.: 'Instala\u00e7\u00e3o de 12k [Marca: Gree | Sala] + Limpeza de 9k'). Os tipos base v\u00e1lidos vivem na entidade TipoServicoValor (Tabela de Servi\u00e7os) \u2014 um enum aqui rejeitava/ignorava updates leg\u00edtimos, como a edi\u00e7\u00e3o de marca no relat\u00f3rio Instala\u00e7\u00f5es por Marca."
    },
    "dia_semana": {
      "type": "string",
      "description": "Dia da semana calculado automaticamente"
    },
    "data_programada": {
      "type": "string",
      "format": "date",
      "description": "Data espec\u00edfica programada para o servi\u00e7o"
    },
    "horario": {
      "type": "string",
      "description": "Hor\u00e1rio do servi\u00e7o"
    },
    "horario_alerta": {
      "type": "boolean",
      "default": false,
      "description": "Se verdadeiro, exibe alerta vermelho de hor\u00e1rio fixo nos cards para os t\u00e9cnicos"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do servi\u00e7o"
    },
    "instalacoes_relatorio_concluidas": {
      "type": "array",
      "items": { "type": "number" },
      "description": "\u00cdndices das instala\u00e7\u00f5es deste servi\u00e7o marcadas como conclu\u00eddas no Relat\u00f3rio de Instala\u00e7\u00f5es (controle de garantia). Persistido no banco para n\u00e3o reaparecer entre dispositivos."
    },
    "valor": {
      "type": "number",
      "description": "Valor do servi\u00e7o (pre\u00e7o total)"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "andamento",
        "concluido",
        "agendado",
        "reagendado"
      ],
      "default": "aberto",
      "description": "Status do servi\u00e7o"
    },
    "observacoes_conclusao": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionadas ao concluir o servi\u00e7o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Servi\u00e7o ativo ou inativo"
    },
    "usuario_atualizacao_status": {
      "type": "string",
      "description": "Email do usu\u00e1rio que alterou o status"
    },
    "data_atualizacao_status": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da \u00faltima altera\u00e7\u00e3o de status"
    },
    "equipe_id": {
      "type": "string",
      "description": "ID da equipe respons\u00e1vel pelo servi\u00e7o"
    },
    "equipe_nome": {
      "type": "string",
      "description": "Nome da equipe respons\u00e1vel (c\u00f3pia para refer\u00eancia r\u00e1pida)"
    },
    "gerar_comissao": {
      "type": "boolean",
      "default": true,
      "description": "Se deve gerar comiss\u00e3o ao concluir o servi\u00e7o"
    },
    "comissao_gerada": {
      "type": "boolean",
      "default": false,
      "description": "Se a comiss\u00e3o j\u00e1 foi gerada"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da conclus\u00e3o do servi\u00e7o"
    }
  },
  "required": [
    "cliente_nome",
    "telefone",
    "tipo_servico",
    "data_programada"
  ]
}