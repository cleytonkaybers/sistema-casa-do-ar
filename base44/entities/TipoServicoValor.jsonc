{
  "name": "TipoServicoValor",
  "type": "object",
  "properties": {
    "tipo_servico": {
      "type": "string",
      "description": "Nome do tipo de servico (texto livre, editavel). Sem enum: a tela permite criar tipos personalizados, e o enum rejeitava silenciosamente nomes novos ou renomeados."
    },
    "valor_tabela": {
      "type": "number",
      "description": "Valor padr\u00e3o da tabela para este tipo de servi\u00e7o"
    },
    "percentual_equipe": {
      "type": "number",
      "default": 30,
      "description": "Percentual de comiss\u00e3o para a equipe (%)"
    },
    "percentual_tecnico": {
      "type": "number",
      "default": 15,
      "description": "Percentual de comiss\u00e3o para o t\u00e9cnico (%)"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o valor est\u00e1 ativo"
    }
  },
  "required": [
    "tipo_servico",
    "valor_tabela"
  ]
}