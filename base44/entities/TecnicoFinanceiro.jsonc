{
  "name": "TecnicoFinanceiro",
  "type": "object",
  "properties": {
    "tecnico_id": {
      "type": "string",
      "description": "ID do t\u00e9cnico (email do usu\u00e1rio)"
    },
    "tecnico_nome": {
      "type": "string",
      "description": "Nome do t\u00e9cnico"
    },
    "equipe_id": {
      "type": "string",
      "description": "ID da equipe"
    },
    "equipe_nome": {
      "type": "string",
      "description": "Nome da equipe"
    },
    "credito_pendente": {
      "type": "number",
      "default": 0,
      "description": "Saldo de cr\u00e9dito pendente de pagamento"
    },
    "credito_pago": {
      "type": "number",
      "default": 0,
      "description": "Total de cr\u00e9dito j\u00e1 pago"
    },
    "total_ganho": {
      "type": "number",
      "default": 0,
      "description": "Total ganho em comiss\u00f5es (pendente + pago)"
    },
    "data_ultimo_pagamento": {
      "type": "string",
      "format": "date-time",
      "description": "Data do \u00faltimo pagamento"
    },
    "oculto": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, o técnico não aparece nas listas de crédito/pagamento (ex-funcionário já acertado). Histórico é preservado."
    },
    "remuneracao": {
      "type": "string",
      "description": "Espelho de User.remuneracao: 'comissao' (padrão) ou 'fixo' (salário semanal — não recebe comissão por serviço)"
    },
    "percentual_comissao": {
      "type": "number",
      "description": "Espelho de User.percentual_comissao. Percentual proprio deste tecnico por servico (%). Vazio = usa o percentual_tecnico da Tabela de Servicos. SEM default de proposito (um default 0 zeraria a comissao de todos)."
    },
    "saldo_zerado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o ADM zerou o saldo deste tecnico. Comissoes e pagamentos ANTERIORES a esta data param de entrar na conta dele, mas continuam no banco (o historico da empresa nao muda). Vazio = conta desde o inicio."
    },
    "saldo_zerado_por": {
      "type": "string",
      "description": "E-mail de quem zerou o saldo."
    },
    "saldo_zerado_valor": {
      "type": "number",
      "description": "Saldo que o tecnico tinha no instante em que foi zerado. Guardado so para consulta depois (negativo = ele devia; positivo = a empresa devia a ele)."
    },
    "data_ultima_atualizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o do saldo"
    }
  },
  "required": [
    "tecnico_id",
    "equipe_id"
  ]
}