{
  "name": "PagamentoCliente",
  "type": "object",
  "properties": {
    "atendimento_id": {
      "type": "string",
      "description": "ID do atendimento conclu\u00eddo"
    },
    "servico_id": {
      "type": "string",
      "description": "ID do servi\u00e7o original"
    },
    "cliente_nome": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone/WhatsApp do cliente"
    },
    "indicacao": {
      "type": "string",
      "description": "Nome de quem indicou este cliente (opcional, apenas informativo)"
    },
    "metodo_pagamento": {
      "type": "string",
      "description": "Como o cliente pagou (PIX, Cartao de Credito, Cartao de Debito, Maquina de Cartao, Transferencia, Dinheiro)"
    },
    "pago_direto_tecnico": {
      "type": "boolean",
      "default": false,
      "description": "true quando o valor foi recebido direto por um tecnico, e nao pelo caixa da empresa. Nao entra na fila de Nota Fiscal."
    },
    "nf_gerada": {
      "type": "boolean",
      "default": false,
      "description": "Nota fiscal ja emitida para esta cobranca (tela Nota Fiscal)"
    },
    "nf_gerada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a nota fiscal foi marcada como emitida"
    },
    "nf_gerada_por": {
      "type": "string",
      "description": "Quem marcou a nota fiscal como emitida"
    },
    "tipo_servico": {
      "type": "string",
      "description": "Tipo de servi\u00e7o realizado"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da conclus\u00e3o do servi\u00e7o"
    },
    "valor_total": {
      "type": "number",
      "description": "Valor total do servi\u00e7o"
    },
    "valor_pago": {
      "type": "number",
      "default": 0,
      "description": "Valor j\u00e1 pago pelo cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "parcial",
        "agendado",
        "pago"
      ],
      "default": "pendente",
      "description": "Status do pagamento"
    },
    "equipe_nome": {
      "type": "string",
      "description": "Nome da equipe que realizou o servi\u00e7o"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o pagamento"
    },
    "data_pagamento_completo": {
      "type": "string",
      "format": "date-time",
      "description": "Data em que o pagamento foi conclu\u00eddo"
    },
    "data_pagamento_agendado": {
      "type": "string",
      "format": "date",
      "description": "Data agendada para o pagamento"
    },
    "historico_pagamentos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "valor": {
            "type": "number"
          },
          "data": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Hist\u00f3rico de pagamentos parciais e totais"
    },
    "arquivado": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o registro foi arquivado"
    }
  },
  "required": [
    "cliente_nome",
    "tipo_servico",
    "valor_total"
  ]
}